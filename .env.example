# ─── LLM Configuration ───────────────────────────────────────
# Any OpenAI-compatible API works (OpenAI, DeepSeek, Groq, local Ollama, etc.)

# API base URL (default: https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1

# Your API key
OPENAI_API_KEY=sk-...

# Model name (e.g. gpt-4o-mini, deepseek-chat, llama3)
OPENAI_MODEL=gpt-4o-mini

# ─── Tool Configuration ──────────────────────────────────────
# Tavily Search API — free tier available at https://tavily.com
TAVILY_API_KEY=tvly-...

# ─── Server ──────────────────────────────────────────────────
# API server port (default: 8787)
PORT=8787
